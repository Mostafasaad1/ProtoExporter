{% macro vec3(v) %}{{ v.x }} {{ v.y }} {{ v.z }}{% endmacro %}
{% macro axis_angle(a) %}{{ a.x }} {{ a.y }} {{ a.z }} {{ a.angle }}{% endmacro %}

{% macro physics_block(p) %}
physics Physics {
  density {{ p.density }}
  mass {{ p.mass }}
  centerOfMass [ {{ vec3(p.center_of_mass) }} ]
}
{% endmacro %}

{% macro bounding_block(b) %}
{% if b.kind.value == "box" %}
boundingObject Pose {
  translation {{ b.local_offset.x }} {{ b.local_offset.y }} {{ b.local_offset.z }}
  children [
    Shape {
      geometry Box {
        size {{ b.size.x }} {{ b.size.y }} {{ b.size.z }}
      }
    }
  ]
}
{% elif b.kind.value == "cylinder" %}
boundingObject Pose {
  translation {{ b.local_offset.x }} {{ b.local_offset.y }} {{ b.local_offset.z }}
  children [
    Shape {
      geometry Cylinder {
        radius {{ b.radius }}
        height {{ b.height }}
      }
    }
  ]
}
{% elif b.kind.value == "mesh" %}
boundingObject Pose {
  children [
    Shape {
      geometry Mesh {
        url [ "{{ b.mesh_relpath }}" ]
      }
    }
  ]
}
{% endif %}
{% endmacro %}

{% macro shape_block(geo) %}
Transform {
  children [
    Shape {
      castShadows FALSE
      geometry Mesh {
        url [ "{{ geo.obj_relpath }}" ]
      }
    }
  ]
}
{% endmacro %}
